FROM eclipse-temurin:21-jre AS java
FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
RUN npm install --global firebase-tools@15.30.2 --no-audit --no-fund
WORKDIR /app
COPY firebase.local.json firebase.local.json
COPY firebase firebase
CMD ["firebase", "emulators:start", "--project", "demo-medplatform-audit", "--config", "firebase.local.json", "--only", "auth,firestore,storage"]
