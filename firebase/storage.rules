rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Preserve authenticated reads of existing content, including legacy paths.
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }
    match /videos/{path=**} {
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    match /courses/{path=**} {
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
