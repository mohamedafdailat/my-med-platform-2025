rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function adminAccess() {
      return request.auth != null && request.auth.token.get('role', '') == 'admin'
        && request.auth.token.get('adminAccessVersion', 0) == 1;
    }
    // Students receive short-lived URLs from the API after semester checks.
    // Metadata reads must not expose long-lived Firebase download tokens.
    match /{allPaths=**} {
      allow read: if adminAccess();
    }
    match /videos/{path=**} {
      allow write: if adminAccess();
    }
    match /courses/{path=**} {
      allow write: if adminAccess();
    }
  }
}
